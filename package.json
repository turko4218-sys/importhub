{
  "name": "importhub",
  "version": "1.0.0",
  "description": "Scraper de productos de Amazon con cola de trabajos y publicacion automatica en MercadoLibre",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/queue/worker.ts",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/queue/worker.js",
    "enqueue": "tsx src/cli/enqueue.ts",
    "ml:auth": "tsx src/cli/mlAuth.ts",
    "jobs:list": "tsx src/cli/listJobs.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "better-sqlite3": "^11.8.1",
    "bullmq": "^5.34.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "nanoid": "^5.0.9",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
