# ---- Servidor ----
PORT=3000
# Usuario/contrasena para acceder al panel y a la API (HTTP Basic Auth).
# Si dejas estos dos vacios, el panel queda SIN autenticacion: esta bien
# para probar en tu propia PC via localhost, pero NUNCA lo expongas asi
# fuera de tu maquina (otra PC, un tunel, un servidor). Completalos antes
# de exponerlo de cualquier forma.
APP_USERNAME=
APP_PASSWORD=

# ---- Redis (cola de trabajos) ----
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=1

# ---- Scraper de Amazon ----
# User-Agent que usara el navegador headless
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
# Retardo minimo/maximo (ms) entre acciones, para no saturar a Amazon
SCRAPER_MIN_DELAY_MS=1500
SCRAPER_MAX_DELAY_MS=4000
# Si pegas una pagina de listado de Amazon (busqueda, categoria, mas
# vendidos, tienda de marca) en vez de un producto puntual, cuantos
# productos como maximo se encolan de ahi.
AMAZON_LISTING_MAX_PRODUCTS=40
# Proxy opcional (http://usuario:pass@host:puerto)
SCRAPER_PROXY_URL=
# Ruta opcional a un binario de Chromium ya instalado (dejar vacio para que
# Playwright use el que descargo/gestiona el mismo)
PLAYWRIGHT_CHROMIUM_PATH=

# ---- MercadoLibre (API oficial) ----
# Datos de tu aplicacion, creada en https://developers.mercadolibre.com.ar/devcenter
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://localhost/callback
# Se completa solo la primera vez con `npm run ml:auth`
ML_REFRESH_TOKEN=
# Sitio de MercadoLibre donde se publica: MLA=Argentina, MLM=Mexico, MLB=Brasil, MCO=Colombia, MLC=Chile, etc.
ML_SITE_ID=MLA
# ID del vendedor (se obtiene automaticamente si se deja vacio)
ML_USER_ID=

# ---- Reglas de publicacion ----
# Tipo de publicacion: gold_special, gold_pro, free, etc. (depende de tu cuenta/sitio)
ML_LISTING_TYPE_ID=gold_special
# Condicion del producto publicado
ML_CONDITION=new
# Cantidad disponible por defecto
ML_DEFAULT_QUANTITY=1
# Forma de envio: me2 (Mercado Envios) o custom
ML_SHIPPING_MODE=not_specified
# Tasa de cambio manual de USD (precio de Amazon) a la moneda del sitio ML.
# Ejemplo: si ML_SITE_ID=MLA (pesos argentinos) y 1 USD = 1050 ARS, poner 1050
PRICE_FX_RATE=1
# Porcentaje de margen que se suma sobre el precio convertido (10 = +10%)
PRICE_MARKUP_PERCENT=30

# ---- Envio internacional ----
# Estimacion por defecto del costo de envio (USD) = base + peso_kg * costo_por_kg.
# Se puede editar manualmente por producto en el panel de revision.
INTL_SHIPPING_BASE_COST_USD=5
INTL_SHIPPING_COST_PER_KG=8

# Publicar automaticamente en ML apenas se scrapea (true), o dejar el
# resultado en estado 'scraped' para revisar/editar en el panel web y
# publicar manualmente (false, recomendado)
AUTO_PUBLISH=false
